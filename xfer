#! /usr/bin/env bash
# Transfer a GitHub repo to a new owner.
# Usage: xfer owner/repo newowner

if [ $# -ne 2 ]; then
  echo "usage: $(basename "$0") owner/repo newowner" >&2
  exit 1
fi

repo="$1"
new_owner="$2"

echo "$repo -> $new_owner"
gh api --method POST "repos/$repo/transfer" -f new_owner="$new_owner"
